NODE_ENV="development"

# Auth
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dezine-mafia-db"

# Email
RESEND_API_KEY="replace-with-your-resend-api-key"
EMAIL_FROM_NAME="Dezine Mafia"
EMAIL_FROM_ADDRESS="noreply@example.com"

# Uploads
# Optional if you are not configuring image uploads yet.
IMAGEKIT_PRIVATE_KEY="replace-with-your-imagekit-private-key"
IMAGEKIT_PUBLIC_KEY="replace-with-your-imagekit-public-key"

# Cache
# Optional. Leave blank or remove both if you are not using Upstash Redis.
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-your-upstash-rest-token"
